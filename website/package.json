{
  "name": "floo-windows-shell",
  "version": "1.0.0",
  "private": true,
  "description": "Floo Windows GUI shell prototype built with React, Vite, and Electron.",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite --host 127.0.0.1 --strictPort",
    "dev:desktop": "concurrently -k \"npm:dev:web\" \"wait-on tcp:127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "preview": "vite preview",
    "build:desktop": "npm run build && electron-builder --dir",
    "build:desktop:win": "npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^9.1.2",
    "electron": "^35.1.5",
    "electron-builder": "^26.0.12",
    "vite": "^5.0.0",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.ntetv.floo.windows",
    "productName": "floo-windows",
    "artifactName": "floo-windows.${ext}",
    "asar": true,
    "directories": {
      "output": "release/windows-gui"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ]
    }
  }
}
