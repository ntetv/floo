# Maintainer: Your Name <your.email@example.com>
pkgname=floo
pkgver=0.1.6
pkgrel=1
pkgdesc="Secure, high-performance tunneling in Zig. Expose your home services or access remote ones"
arch=('x86_64' 'aarch64')
url="https://github.com/NTETV/floo"
license=('MIT')
provides=('floo' 'flooc' 'floos')
conflicts=('floo-git')
source_x86_64=("${pkgname}-${pkgver}-x86_64.tar.gz::https://github.com/NTETV/floo/releases/download/v${pkgver}/floo-x86_64-linux-musl.tar.gz")
source_aarch64=("${pkgname}-${pkgver}-aarch64.tar.gz::https://github.com/NTETV/floo/releases/download/v${pkgver}/floo-aarch64-linux-musl.tar.gz")
sha256sums_x86_64=('ce0e86f031e76c82cecf8cff95c44c5203f70f5a14aa045f9d25885d518339ca')
sha256sums_aarch64=('f806457ed43c5746b3c32224085b9a9b7241e65bbac5125703a4d4833a0c3886')

package() {
    cd "${srcdir}/${pkgname}-${pkgver}-${CARCH}"

    # Install binaries
    install -Dm755 flooc "${pkgdir}/usr/bin/flooc"
    install -Dm755 floos "${pkgdir}/usr/bin/floos"

    # Install documentation
    install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"

    # Install example configs
    install -Dm644 flooc.toml.example "${pkgdir}/usr/share/doc/${pkgname}/examples/flooc.toml.example"
    install -Dm644 floos.toml.example "${pkgdir}/usr/share/doc/${pkgname}/examples/floos.toml.example"

    # Install license (if included in tarball)
    if [ -f LICENSE ]; then
        install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    fi
}
